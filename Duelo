        document.getElementById('final-p2-badge').textContent = isPizza ? '👑 Pizza Campeã' : '👑 Pastel Campeão';
        document.getElementById('final-p1-badge').textContent = '🥈 Vice-Campeão';
      } else {
        titleEl.textContent = '🤝 Empate Perfeito de Casal!';
        subEl.textContent = `Ambos fizeram ${eval1.totalScore} pontos — sintonia total na cozinha!`;
        document.getElementById('final-p1-badge').textContent = '👑 Empate de Ouro';
        document.getElementById('final-p2-badge').textContent = '👑 Empate de Ouro';
      }

      [
        { player: p1, evalData: eval1, prefix: 'p1', idx: 0 },
        { player: p2, evalData: eval2, prefix: 'p2', idx: 1 }
      ].forEach(({ player, evalData, prefix, idx }) => {
        const youLabel = (gameState.isOnline && idx === myPlayerIndex) ? ' (Você)' : '';
        document.getElementById(`final-${prefix}-name`).textContent = `${player.name}${youLabel}`;
        document.getElementById(`final-${prefix}-score`).textContent = `${evalData.totalScore} pts`;
        document.getElementById(`final-${prefix}-dish`).innerHTML = renderDishSVG(gameState.mode, player.wonItems);

        const ingBox = document.getElementById(`final-${prefix}-ingredients`);
        if (player.wonItems.length === 0) {
          ingBox.innerHTML = `<span class="text-xs italic text-stone-400">Nenhum ingrediente conquistado</span>`;
        } else {
          ingBox.innerHTML = player.wonItems.map(entry => {
            const info = INGREDIENTS_DB.find(i => i.id === entry.id);
            return `
              <button
                type="button"
                onmouseenter="highlightFinalDishItem('${prefix}', '${entry.id}')"
                onmouseleave="highlightFinalDishItem('${prefix}', null)"
                onclick="highlightFinalDishItem('${prefix}', '${entry.id}')"
                class="inline-flex items-center gap-1 text-xs font-bold bg-white hover:bg-amber-100 border border-stone-300 px-2.5 py-1 rounded-xl shadow-xs transition cursor-pointer"
              >
                <span>${info.emoji}</span>
                <span>${info.shortName}</span>
                <span class="text-stone-400">• R$${entry.price}</span>
              </button>
            `;
          }).join('');
        }

        const notesBox = document.getElementById(`final-${prefix}-notes`);
        notesBox.innerHTML = evalData.notes.map(n => {
          let cls = 'bg-stone-100 border-stone-300 text-stone-800';
          if (n.type === 'bonus') cls = 'bg-emerald-100 border-emerald-300 text-emerald-950';
          if (n.type === 'gororoba') cls = 'bg-amber-100 border-amber-400 text-amber-950';
          return `
            <div class="p-2.5 rounded-xl border ${cls} text-xs">
              <div class="font-extrabold">${n.title}</div>
              <div class="opacity-90 mt-0.5">${n.desc}</div>
            </div>
          `;
        }).join('');
      });

      const hasCrime = eval1.notes.some(n => n.type === 'gororoba') || eval2.notes.some(n => n.type === 'gororoba');
      const chefComment = document.getElementById('final-chef-comment');
      if (isPizza) {
        chefComment.textContent = hasCrime
          ? '"Mamma mia! Em Nápoles essa mistura ia dar o que falar, mas no amor e na pizza vale tudo! Quem perdeu hoje paga a próxima pizzaria!"'
          : '"Bellissima! Massa assada no ponto, recheios dignos de pizzaria premiada! Quem perdeu hoje tem que pagar a pizza de verdade no fim de semana!"';
      } else {
        chefComment.textContent = hasCrime
          ? '"Olha, em 30 anos na feira eu nunca vi uma mistura tão ousada assim! Quem perdeu hoje vai ter que pagar o caldo de cana!"'
          : '"Que aula de pastelaria de feira! Recheios caprichados de dar água na boca. Quem perdeu hoje paga o pastel de verdade no próximo passeio!"';
      }

      playFanfareSound();
