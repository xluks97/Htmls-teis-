<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Duelo Gastronômico: Pastel ou Pizza</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Fredoka (títulos expressivos) e Plus Jakarta Sans (interface limpa) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            display: ['"Fredoka"', 'cursive'],
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
          colors: {
            cream: '#FFFDF7',
            p1: {
              light: '#F0FDFA',
              soft: '#CCFBF1',
              main: '#0D9488',
              dark: '#0F766E',
              deep: '#115E59',
            },
            p2: {
              light: '#FFF1F2',
              soft: '#FFE4E6',
              main: '#E11D48',
              dark: '#BE123C',
              deep: '#9F1239',
            }
          }
        }
      }
    };
  </script>

  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: #FFFDF7;
      background-image:
        radial-gradient(#FDE68A 1.25px, transparent 1.25px),
        radial-gradient(#FED7AA 1.25px, #FFFDF7 1.25px);
      background-size: 34px 34px;
      background-position: 0 0, 17px 17px;
      overflow-x: hidden;
    }

    h1, h2, h3, .font-display {
      font-family: 'Fredoka', cursive;
    }

    /* Toalha xadrez vermelha e branca clássica */
    .xadrez-bg {
      background-color: #FFFFFF;
      background-image:
        linear-gradient(45deg, rgba(225, 29, 72, 0.11) 25%, transparent 25%),
        linear-gradient(-45deg, rgba(225, 29, 72, 0.11) 25%, transparent 25%),
        linear-gradient(45deg, transparent 75%, rgba(225, 29, 72, 0.11) 75%),
        linear-gradient(-45deg, transparent 75%, rgba(225, 29, 72, 0.11) 75%);
      background-size: 24px 24px;
      background-position: 0 0, 0 12px, 12px -12px, -12px 0;
    }

    .header-pattern {
      background: linear-gradient(135deg, #DC2626 0%, #B91C1C 100%);
    }

    /* Botão 3D tátil */
    .btn-3d {
      transition: transform 0.1s ease, box-shadow 0.1s ease, filter 0.15s ease;
    }
    .btn-3d:active:not(:disabled) {
      transform: translateY(3px);
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.25) !important;
    }
    .btn-3d:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }

    @keyframes popIn {
      0% { opacity: 0; transform: scale(0.92) translateY(8px); }
      70% { transform: scale(1.02) translateY(-2px); }
      100% { opacity: 1; transform: scale(1) translateY(0); }
    }
    .animate-pop {
      animation: popIn 0.32s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px) rotate(-1deg); }
      50% { transform: translateY(-6px) rotate(1deg); }
    }
    .animate-float {
      animation: floatSlow 3.5s ease-in-out infinite;
    }

    @keyframes hammerHit {
      0% { transform: rotate(-40deg) scale(1.35); opacity: 0; }
      55% { transform: rotate(10deg) scale(0.95); opacity: 1; }
      100% { transform: rotate(0deg) scale(1); opacity: 1; }
    }
    .animate-hammer {
      animation: hammerHit 0.4s ease-out forwards;
    }

    /* Slider customizado */
    input[type="range"] {
      -webkit-appearance: none;
      appearance: none;
      height: 12px;
      border-radius: 999px;
      background: #E7E5E4;
      outline: none;
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: #F59E0B;
      border: 3px solid #FFFFFF;
      box-shadow: 0 3px 8px rgba(0, 0, 0, 0.25);
      cursor: pointer;
    }
    input[type="range"]::-moz-range-thumb {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: #F59E0B;
      border: 3px solid #FFFFFF;
      box-shadow: 0 3px 8px rgba(0, 0, 0, 0.25);
      cursor: pointer;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col text-stone-800 selection:bg-amber-300 selection:text-stone-950">

  <!-- CANVAS DE CONFETES (TELA FINAL) -->
  <canvas id="confetti-canvas" class="fixed inset-0 pointer-events-none z-50 hidden"></canvas>

  <!-- TOAST DE NOTIFICAÇÃO DISCRETO -->
  <div id="toast-banner" class="hidden fixed bottom-5 left-1/2 -translate-x-1/2 z-50 bg-stone-900/95 text-white text-xs sm:text-sm font-bold px-4 py-2.5 rounded-2xl shadow-xl border border-amber-400/60 flex items-center gap-2 max-w-[92vw] text-center">
    <span id="toast-text">Código copiado!</span>
  </div>

  <!-- CABEÇALHO -->
  <header class="header-pattern text-white shadow-lg border-b-4 border-amber-400 sticky top-0 z-30">
    <div class="max-w-5xl mx-auto px-3 sm:px-6 py-2.5 flex items-center justify-between gap-2">
      <div class="flex items-center gap-2.5 min-w-0">
        <div id="header-mode-icon" class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl bg-amber-400 text-stone-900 flex items-center justify-center shadow-md border-2 border-white text-2xl select-none shrink-0">
          🥟
        </div>
        <div class="min-w-0">
          <div class="flex items-center gap-2 flex-wrap">
            <h1 class="text-lg sm:text-2xl font-bold leading-none tracking-tight drop-shadow truncate">
              Duelo Gastronômico
            </h1>
            <span id="connection-status-badge" class="inline-flex items-center gap-1 text-[10px] sm:text-[11px] font-extrabold bg-black/25 text-amber-100 px-2 py-0.5 rounded-full border border-white/20">
              <span id="connection-dot" class="w-2 h-2 rounded-full bg-amber-300 animate-pulse"></span>
              <span id="connection-text">Conectando...</span>
            </span>
          </div>
          <p id="header-subtitle" class="text-[11px] sm:text-xs text-amber-200 font-bold tracking-wide uppercase mt-0.5 truncate">
            Pastel ou Pizza • 2 Celulares ou Local
          </p>
        </div>
      </div>

      <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
        <span id="header-room-badge" class="hidden bg-white text-red-700 font-extrabold text-xs sm:text-sm px-2.5 py-1 rounded-full shadow border border-amber-300">
          Sala ----
        </span>
        <span id="header-round-badge" class="hidden bg-amber-400 text-stone-950 font-extrabold text-xs sm:text-sm px-2.5 sm:px-3 py-1 rounded-full shadow border border-amber-200">
          Item 1
        </span>
        <button id="btn-sound" onclick="toggleSound()" title="Alternar Sons" class="p-2 sm:p-2.5 rounded-xl bg-white/15 hover:bg-white/25 text-white transition border border-white/25 text-sm font-bold flex items-center gap-1 cursor-pointer">
          <span id="sound-icon">🔊</span>
          <span class="hidden sm:inline text-xs">Som</span>
        </button>
        <button onclick="toggleRulesModal(true)" class="p-2 sm:p-2.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-stone-950 font-extrabold text-xs sm:text-sm shadow transition border border-amber-200 cursor-pointer">
          📜 <span class="hidden sm:inline">Regras</span>
        </button>
      </div>
    </div>
  </header>

  <!-- CONTEÚDO PRINCIPAL -->
  <main class="flex-1 w-full max-w-5xl mx-auto px-3 sm:px-6 py-5 sm:py-7 flex flex-col justify-center">

    <!-- =========================================================================
         TELA 1: LOBBY DE 2 CELULARES (ONLINE) OU CONFIGURAÇÃO OFFLINE
         ========================================================================= -->
    <section id="screen-setup" class="animate-pop space-y-5">
      <div class="bg-white/95 backdrop-blur rounded-3xl shadow-xl border-4 border-amber-400 overflow-hidden">

        <!-- Banner Hero -->
        <div class="xadrez-bg px-4 py-5 sm:p-7 text-center border-b-2 border-amber-200">
          <span class="inline-flex items-center gap-1.5 bg-red-600 text-white text-xs sm:text-sm font-extrabold px-4 py-1.5 rounded-full shadow mb-2">
            📱 JOGUE EM 2 CELULARES AO VIVO • R$ 30 CADA
          </span>
          <h2 class="text-2xl sm:text-4xl font-bold text-stone-900 leading-tight">
            Duelo do <span class="text-amber-600">Pastel</span> ou da <span class="text-red-600">Pizza</span>!
          </h2>
          <p class="mt-1.5 text-stone-600 text-xs sm:text-base max-w-2xl mx-auto">
            Cada um no seu telefone: escolham os ingredientes juntos, cubram os lances ao vivo e vejam quem monta o prato campeão!
          </p>

          <!-- Seletor de Modo de Dispositivo: 2 Celulares Online vs Mesmo Celular Offline -->
          <div class="mt-4 inline-flex p-1.5 rounded-2xl bg-stone-900/10 border border-amber-300/80 gap-1.5 max-w-full">
            <button
              type="button"
              id="tab-device-online"
              onclick="switchDeviceMode('online')"
              class="px-3.5 sm:px-5 py-2 rounded-xl bg-red-600 text-white font-extrabold text-xs sm:text-sm shadow transition cursor-pointer"
            >
              📱 2 Celulares (Online)
            </button>
            <button
              type="button"
              id="tab-device-offline"
              onclick="switchDeviceMode('offline')"
              class="px-3.5 sm:px-5 py-2 rounded-xl bg-white/80 hover:bg-white text-stone-700 font-bold text-xs sm:text-sm transition cursor-pointer"
            >
              🤝 Mesmo Celular (Offline)
            </button>
          </div>
        </div>

        <!-- ===================================================================
             PAINEL A: MULTIPLAYER ONLINE EM 2 CELULARES
             =================================================================== -->
        <div id="setup-online-panel" class="p-4 sm:p-8 space-y-6">

          <!-- SUB-ETAPA A1: CRIAR SALA OU ENTRAR NA SALA -->
          <div id="online-entry-view" class="space-y-6">
            <!-- Seu Nome neste telefone -->
            <div class="bg-amber-50/90 rounded-2xl p-4 sm:p-5 border-2 border-amber-300">
              <label for="input-online-my-name" class="block text-xs font-extrabold uppercase tracking-wider text-amber-950 mb-1.5">
                1. Seu nome neste telefone:
              </label>
              <div class="flex flex-col sm:flex-row gap-2.5">
                <input
                  id="input-online-my-name"
                  type="text"
                  maxlength="16"
                  value="Eu"
                  placeholder="Digite seu apelido (ex: Eu, Namorada)"
                  class="flex-1 px-4 py-3 rounded-xl border-2 border-amber-400 focus:border-red-500 focus:ring-2 focus:ring-amber-200 outline-none font-bold text-stone-900 bg-white text-base"
                />
                <div class="flex gap-1.5 flex-wrap">
                  <button type="button" onclick="setMyOnlineName('Eu')" class="px-3 py-2 rounded-xl bg-white hover:bg-amber-100 border border-amber-300 text-xs font-extrabold text-stone-700 cursor-pointer">😎 Eu</button>
                  <button type="button" onclick="setMyOnlineName('Namorada')" class="px-3 py-2 rounded-xl bg-white hover:bg-amber-100 border border-amber-300 text-xs font-extrabold text-stone-700 cursor-pointer">😍 Namorada</button>
                  <button type="button" onclick="setMyOnlineName('Amor')" class="px-3 py-2 rounded-xl bg-white hover:bg-amber-100 border border-amber-300 text-xs font-extrabold text-stone-700 cursor-pointer">❤️ Amor</button>
                </div>
              </div>
            </div>

            <!-- Erro inline de sala -->
            <div id="online-entry-error" class="hidden p-3.5 rounded-2xl bg-red-100 border-2 border-red-400 text-red-900 text-xs sm:text-sm font-bold text-center"></div>

            <!-- Duas Opções: Criar Sala ou Entrar com Código -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

              <!-- OPÇÃO A: CRIAR SALA (JOGADOR 1) -->
              <div class="rounded-3xl p-5 border-3 border-teal-400 bg-p1-light/70 flex flex-col justify-between space-y-4">
                <div>
                  <span class="inline-block text-[11px] font-extrabold uppercase tracking-wider bg-teal-600 text-white px-3 py-0.5 rounded-full">
                    Opção A • Anfitrião
                  </span>
                  <h3 class="font-display text-2xl font-bold text-teal-950 mt-1.5">
                    Criar Nova Sala
                  </h3>
                  <p class="text-xs sm:text-sm text-stone-600 mt-1">
                    Escolha o prato e gere um código de 4 dígitos para enviar no WhatsApp do seu par.
                  </p>

                  <!-- Escolha rápida Pastel ou Pizza -->
                  <div class="grid grid-cols-2 gap-2.5 mt-4">
                    <button
                      type="button"
                      id="online-create-pastel"
                      onclick="selectGameMode('pastel')"
                      class="p-3 rounded-2xl border-3 border-amber-500 bg-white shadow-xs text-center transition cursor-pointer"
                    >
                      <div class="text-3xl">🥟</div>
                      <div class="font-display font-bold text-sm text-stone-900 mt-1">Pastel</div>
                    </button>
                    <button
                      type="button"
                      id="online-create-pizza"
                      onclick="selectGameMode('pizza')"
                      class="p-3 rounded-2xl border-2 border-stone-200 bg-white/70 hover:bg-white text-center transition cursor-pointer"
                    >
                      <div class="text-3xl">🍕</div>
                      <div class="font-display font-bold text-sm text-stone-900 mt-1">Pizza</div>
                    </button>
                  </div>
                </div>

                <button
                  type="button"
                  id="btn-create-room"
                  onclick="createOnlineRoom()"
                  class="btn-3d w-full py-3.5 px-5 rounded-2xl bg-teal-600 hover:bg-teal-700 text-white font-display text-xl font-bold shadow-[0_4px_0_#115E59] border border-teal-300 cursor-pointer"
                >
                  ✨ Criar Sala (4 Dígitos)
                </button>
              </div>

              <!-- OPÇÃO B: ENTRAR NA SALA (JOGADOR 2) -->
              <div class="rounded-3xl p-5 border-3 border-rose-400 bg-p2-light/70 flex flex-col justify-between space-y-4">
                <div>
                  <span class="inline-block text-[11px] font-extrabold uppercase tracking-wider bg-rose-600 text-white px-3 py-0.5 rounded-full">
                    Opção B • Convidado(a)
                  </span>
                  <h3 class="font-display text-2xl font-bold text-rose-950 mt-1.5">
                    Entrar na Sala
                  </h3>
                  <p class="text-xs sm:text-sm text-stone-600 mt-1">
                    Recebeu o código de 4 dígitos? Digite abaixo para entrar na mesma partida ao vivo!
                  </p>

                  <div class="mt-4">
                    <label for="input-join-room-code" class="block text-xs font-extrabold uppercase text-rose-900 mb-1.5">
                      Código da Sala (4 números):
                    </label>
                    <input
                      id="input-join-room-code"
                      type="text"
                      inputmode="numeric"
                      pattern="[0-9]*"
                      maxlength="4"
                      placeholder="Ex: 4829"
                      class="w-full px-4 py-3 rounded-2xl border-2 border-rose-300 focus:border-rose-600 focus:ring-2 focus:ring-rose-200 outline-none font-display text-3xl font-bold tracking-[0.35em] text-center text-stone-900 bg-white"
                    />
                  </div>
                </div>

                <button
                  type="button"
                  id="btn-join-room"
                  onclick="joinOnlineRoom()"
                  class="btn-3d w-full py-3.5 px-5 rounded-2xl bg-rose-600 hover:bg-rose-700 text-white font-display text-xl font-bold shadow-[0_4px_0_#9F1239] border border-rose-300 cursor-pointer"
                >
                  📲 Entrar na Sala
                </button>
              </div>

            </div>
          </div>

          <!-- SUB-ETAPA A2: SALA DE ESPERA COLABORATIVA (LOBBY AO VIVO) -->
          <div id="online-lobby-view" class="hidden space-y-6 animate-pop">

            <!-- Barra do Código da Sala + Copiar para WhatsApp -->
            <div class="xadrez-bg rounded-3xl p-4 sm:p-6 border-3 border-amber-400 flex flex-col sm:flex-row items-center justify-between gap-4">
              <div class="text-center sm:text-left">
                <span class="text-[11px] font-extrabold uppercase tracking-wider bg-red-600 text-white px-3 py-0.5 rounded-full">
                  Código da Sala • Mande no WhatsApp
                </span>
                <div class="flex items-center justify-center sm:justify-start gap-3 mt-1.5">
                  <span id="lobby-room-code-display" class="font-display text-4xl sm:text-5xl font-bold tracking-[0.2em] text-stone-900 bg-white px-4 py-1.5 rounded-2xl border-2 border-amber-400 shadow-xs">
                    0000
                  </span>
                  <button
                    type="button"
                    onclick="copyRoomCode()"
                    class="btn-3d px-4 py-3 rounded-2xl bg-amber-400 hover:bg-amber-500 text-stone-950 font-extrabold text-xs sm:text-sm shadow-[0_3px_0_#B45309] border border-amber-200 cursor-pointer"
                  >
                    📋 Copiar Código
                  </button>
                </div>
              </div>

              <div class="flex flex-col items-center sm:items-end gap-2">
                <div id="lobby-mode-pill" class="bg-white px-3.5 py-1.5 rounded-xl border border-amber-300 font-bold text-xs sm:text-sm text-stone-800 shadow-xs">
                  🥟 Modo: Pastel de Feira
                </div>
                <div id="lobby-host-mode-switch" class="flex gap-1.5">
                  <button type="button" onclick="updateLobbyMode('pastel')" class="px-2.5 py-1 rounded-lg bg-amber-100 hover:bg-amber-200 text-amber-950 font-bold text-xs border border-amber-300 cursor-pointer">
                    🥟 Pastel
                  </button>
                  <button type="button" onclick="updateLobbyMode('pizza')" class="px-2.5 py-1 rounded-lg bg-red-100 hover:bg-red-200 text-red-950 font-bold text-xs border border-red-300 cursor-pointer">
                    🍕 Pizza
                  </button>
                  <button type="button" onclick="leaveOnlineRoom()" class="px-2.5 py-1 rounded-lg bg-stone-200 hover:bg-stone-300 text-stone-700 font-bold text-xs cursor-pointer">
                    🚪 Sair
                  </button>
                </div>
              </div>
            </div>

            <!-- Status dos 2 Jogadores Conectados -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              <div class="rounded-2xl p-4 border-2 border-teal-400 bg-p1-light flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <span class="text-3xl">😎</span>
                  <div>
                    <div class="text-[11px] font-extrabold uppercase text-teal-800">Jogador 1 (Anfitrião)</div>
                    <div id="lobby-p1-name" class="font-display text-xl font-bold text-teal-950">Eu</div>
                  </div>
                </div>
                <span class="text-xs font-extrabold bg-teal-600 text-white px-3 py-1 rounded-full">
                  ✅ Na sala
                </span>
              </div>

              <div id="lobby-p2-card" class="rounded-2xl p-4 border-2 border-dashed border-rose-300 bg-p2-light/50 flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <span class="text-3xl">😍</span>
                  <div>
                    <div class="text-[11px] font-extrabold uppercase text-rose-800">Jogador 2 (Parceiro/a)</div>
                    <div id="lobby-p2-name" class="font-display text-lg font-bold text-rose-900">Aguardando entrar...</div>
                  </div>
                </div>
                <span id="lobby-p2-status" class="text-xs font-extrabold bg-amber-200 text-amber-950 px-3 py-1 rounded-full animate-pulse">
                  ⏳ Esperando
                </span>
              </div>
            </div>

            <!-- Seleção Colaborativa de Ingredientes (Sincronizada ao Vivo) -->
            <div>
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
                <div>
                  <h3 class="text-lg sm:text-xl font-bold text-stone-900 flex items-center gap-2 flex-wrap">
                    <span>🥗 Ingredientes do Leilão (Vocês dois podem marcar!):</span>
                    <span id="lobby-selected-count" class="text-xs font-extrabold bg-stone-800 text-white px-2.5 py-0.5 rounded-full">
                      16 selecionados
                    </span>
                  </h3>
                  <p class="text-xs text-stone-500 mt-0.5">
                    Toquem nos ingredientes no seu próprio celular para adicionar ou remover da disputa ao vivo.
                  </p>
                </div>

                <div class="flex flex-wrap gap-1.5">
                  <button type="button" onclick="applyLobbyPreset('all')" class="px-3 py-1.5 rounded-xl bg-amber-100 hover:bg-amber-200 text-amber-950 font-bold text-xs border border-amber-300 transition cursor-pointer">
                    Todos
                  </button>
                  <button type="button" onclick="applyLobbyPreset('savory')" class="px-3 py-1.5 rounded-xl bg-stone-100 hover:bg-stone-200 text-stone-800 font-bold text-xs border border-stone-300 transition cursor-pointer">
                    Só Salgados
                  </button>
                  <button type="button" onclick="applyLobbyPreset('classic')" class="px-3 py-1.5 rounded-xl bg-red-100 hover:bg-red-200 text-red-900 font-bold text-xs border border-red-300 transition cursor-pointer">
                    Mix Clássico
                  </button>
                </div>
              </div>

              <div id="lobby-ingredients-grid" class="grid grid-cols-2 sm:grid-cols-4 gap-2.5"></div>

              <div id="lobby-min-warning" class="hidden mt-3 p-3 rounded-2xl bg-red-100 border-2 border-red-400 text-red-900 text-xs sm:text-sm font-bold text-center">
                ⚠️ Mantenham pelo menos 4 ingredientes marcados para iniciar o leilão!
              </div>
            </div>

            <!-- Rodapé do Lobby: Iniciar Leilão (Anfitrião) ou Aguardando (Convidado) -->
            <div class="pt-2 text-center">
              <div id="lobby-host-start-box">
                <button
                  type="button"
                  id="btn-start-online-game"
                  onclick="startOnlineMatch()"
                  class="btn-3d w-full sm:w-auto px-10 py-4 rounded-2xl bg-gradient-to-b from-red-500 to-red-600 hover:from-red-600 hover:to-red-700 text-white font-display text-2xl sm:text-3xl font-bold shadow-[0_5px_0_#991B1B] border-2 border-red-300 cursor-pointer"
                >
                  🔨 Começar Leilão!
                </button>
                <p id="lobby-waiting-partner-hint" class="text-xs font-bold text-amber-800 mt-2">
                  💡 Aguardando o 2º celular entrar com o código acima para liberar o início!
                </p>
              </div>

              <div id="lobby-guest-wait-box" class="hidden p-4 rounded-2xl bg-amber-100 border-2 border-amber-400 text-amber-950 font-bold text-sm sm:text-base">
                ⏳ Você já está na sala! Aguardando <span id="lobby-host-name-span" class="underline">o anfitrião</span> clicar em <strong>Começar Leilão!</strong>
              </div>
            </div>
          </div>

        </div>

        <!-- ===================================================================
             PAINEL B: MODO OFFLINE NO MESMO CELULAR
             =================================================================== -->
        <div id="setup-offline-panel" class="hidden p-4 sm:p-8 space-y-7">
          <!-- Preview Dinâmico do Prato Escolhido -->
