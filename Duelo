    async function toggleLobbyIngredient(ingId) {
      if (!currentUser || !currentRoomCode || !lastRoomSnapshot) return;
      const currentList = new Set(lastRoomSnapshot.selectedIngredients || []);
      const owners = { ...(lastRoomSnapshot.ingredientOwners || {}) };

      if (currentList.has(ingId)) {
        currentList.delete(ingId);
        delete owners[ingId];
        playTone(420, 'sine', 0.06, 0.08);
      } else {
        currentList.add(ingId);
        owners[ingId] = myPlayerIndex;
        playTone(640, 'sine', 0.06, 0.08);
      }

      try {
        await updateDoc(getRoomDocRef(currentRoomCode), {
          selectedIngredients: Array.from(currentList),
          ingredientOwners: owners,
          updatedAt: Date.now()
        });
      } catch (e) {
        console.error(e);
      }
    }

    async function applyLobbyPreset(preset) {
      if (!currentUser || !currentRoomCode) return;
      let ids = [];
      if (preset === 'all') {
        ids = INGREDIENTS_DB.map(i => i.id);
      } else if (preset === 'savory') {
        ids = INGREDIENTS_DB.filter(i => i.category === 'Salgado').map(i => i.id);
      } else if (preset === 'classic') {
        ids = INGREDIENTS_DB.filter(i => i.classic).map(i => i.id);
      }

      const owners = {};
      ids.forEach(id => { owners[id] = myPlayerIndex; });

      try {
        await updateDoc(getRoomDocRef(currentRoomCode), {
          selectedIngredients: ids,
          ingredientOwners: owners,
          updatedAt: Date.now()
        });
        playBidRaiseSound(6);
      } catch (e) {
        console.error(e);
      }
