    function launchConfetti() {
      const canvas = document.getElementById('confetti-canvas');
      canvas.classList.remove('hidden');
      const ctx = canvas.getContext('2d');
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;

      const colors = ['#F59E0B', '#E11D48', '#0D9488', '#FACC15', '#10B981', '#FB7185'];
      const pieces = Array.from({ length: 110 }, () => ({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height - canvas.height,
        w: 8 + Math.random() * 8,
        h: 5 + Math.random() * 6,
        color: colors[Math.floor(Math.random() * colors.length)],
        vy: 2.5 + Math.random() * 3.5,
        vx: (Math.random() - 0.5) * 2.5,
        rot: Math.random() * 360,
        vrot: (Math.random() - 0.5) * 8
      }));

      let frames = 0;
      function animateConfetti() {
        frames += 1;
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        pieces.forEach(p => {
          p.x += p.vx;
          p.y += p.vy;
          p.rot += p.vrot;
          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate((p.rot * Math.PI) / 180);
          ctx.fillStyle = p.color;
          ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
          ctx.restore();
        });

        if (frames < 190) requestAnimationFrame(animateConfetti);
        else {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          canvas.classList.add('hidden');
        }
      }
      requestAnimationFrame(animateConfetti);
    }

    function toggleRulesModal(show) {
      const modal = document.getElementById('modal-rules');
      if (show) modal.classList.remove('hidden');
      else modal.classList.add('hidden');
    }

    function openDishModal(playerIdx) {
      const player = gameState.players[playerIdx];
      const dishLabel = gameState.mode === 'pastel' ? 'Pastel' : 'Pizza';
      document.getElementById('dish-modal-title').textContent = `${dishLabel} de ${player.name}`;
      document.getElementById('dish-modal-art').innerHTML = renderDishSVG(gameState.mode, player.wonItems);

      const list = document.getElementById('dish-modal-list');
      if (player.wonItems.length === 0) {
        list.innerHTML = `<span class="text-xs italic text-stone-400">Nenhum ingrediente conquistado ainda</span>`;
      } else {
        list.innerHTML = player.wonItems.map(entry => {
          const info = INGREDIENTS_DB.find(i => i.id === entry.id);
          return `
            <span class="inline-flex items-center gap-1 text-xs font-bold bg-amber-100 border border-amber-300 px-2.5 py-1 rounded-xl">
              ${info.emoji} ${info.shortName} (R$ ${entry.price})
