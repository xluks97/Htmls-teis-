     * @param {Array<{id: string, price: number}>} wonItems - Itens arrematados
     * @param {string|null} highlightId - ID do ingrediente para destacar
     */
    function renderDishSVG(mode, wonItems = [], highlightId = null) {
      svgUidCounter += 1;
      const uid = `dish_${svgUidCounter}`;

      const counts = {};
      wonItems.forEach(entry => {
        const id = typeof entry === 'string' ? entry : entry.id;
        counts[id] = (counts[id] || 0) + 1;
      });

      const has = (id) => (counts[id] || 0) > 0;
      const qty = (id) => counts[id] || 0;

      const wrapLayer = (id, content) => {
        if (!has(id)) return '';
        const isDimmed = highlightId && highlightId !== id;
        const opacity = isDimmed ? '0.22' : '1';
        return `<g opacity="${opacity}" style="transition: opacity 0.2s ease;">${content}</g>`;
      };

      if (mode === 'pizza') {
        return renderPizzaModeSVG(uid, wonItems.length, has, qty, wrapLayer);
      }
      return renderPastelModeSVG(uid, wonItems.length, has, qty, wrapLayer);
    }

