    async function rematchSameSetup() {
      if (gameState.isOnline && currentRoomCode && currentUser) {
        // Volta os dois celulares conectados para a Sala de Espera colaborativa
        await updateDoc(getRoomDocRef(currentRoomCode), {
          status: 'lobby',
          p1Money: INITIAL_BUDGET,
          p1WonItems: [],
          p2Money: INITIAL_BUDGET,
          p2WonItems: [],
          roundPhase: 'bidding',
          roundOutcome: null,
          updatedAt: Date.now()
        });
      } else {
        startOfflineGame();
      }
    }

    function backToSetup() {
      if (gameState.isOnline) {
        leaveOnlineRoom();
      } else {
        document.getElementById('screen-final').classList.add('hidden');
        document.getElementById('screen-game').classList.add('hidden');
        document.getElementById('header-round-badge').classList.add('hidden');
        document.getElementById('screen-setup').classList.remove('hidden');
        renderSetupHeroPreview();
      }
    }

