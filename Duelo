  <!-- =========================================================================
       4. MOTOR MULTIPLAYER ONLINE (FIREBASE FIRESTORE) + MODO OFFLINE
       ========================================================================= -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
    import { getAuth, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
    import { getFirestore, doc, getDoc, setDoc, updateDoc, onSnapshot } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

    const INITIAL_BUDGET = 30;
    const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-app-id';

    let db = null;
    let auth = null;
    let currentUser = null;
    let firebaseReady = false;

    // Estado de Sessão (Online vs Offline)
    let deviceMode = 'online'; // 'online' | 'offline'
    let selectedMode = 'pastel'; // 'pastel' | 'pizza'
    let selectedIngredientIds = new Set(INGREDIENTS_DB.map(i => i.id));

    // Estado da Sala Online (2 Celulares)
    let currentRoomCode = null;
    let myPlayerIndex = 0; // 0 = Anfitrião (P1), 1 = Convidado (P2)
    let roomUnsubscribe = null;
    let lastRoomSnapshot = null;
    let dishViewMode = 'mine'; // 'mine' | 'partner' | 'both'
    let autoAdvanceTimer = null;

    // Estado Unificado da Partida em Andamento
    let gameState = {
      isOnline: false,
      mode: 'pastel',
      players: [
        { name: 'Eu', money: INITIAL_BUDGET, wonItems: [] },
        { name: 'Namorada', money: INITIAL_BUDGET, wonItems: [] }
      ],
      selectedPool: [],
      deck: [],
      itemNumber: 1,
      currentIngredient: null,
      currentBid: 0,
      highestBidderIndex: null,
      activeTurnIndex: 0,
      passesCount: 0,
      bidHistory: [],
      customSliderVal: 1,
      roundPhase: 'bidding', // 'bidding' | 'hammer'
      roundOutcome: null
    };

    /* -------------------------------------------------------------------------
       4A. INICIALIZAÇÃO DO FIREBASE E AUTENTICAÇÃO ANÔNIMA / CUSTOM TOKEN
       ------------------------------------------------------------------------- */
    async function initFirebaseService() {
      const statusText = document.getElementById('connection-text');
      const statusDot = document.getElementById('connection-dot');

      try {
        if (typeof __firebase_config === 'undefined' || !__firebase_config) {
          throw new Error('Configuração do Firebase ausente');
        }
        const firebaseConfig = JSON.parse(__firebase_config);
        const app = initializeApp(firebaseConfig);
        auth = getAuth(app);
        db = getFirestore(app);

        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }

        currentUser = auth.currentUser;
        if (!currentUser) {
          throw new Error('Falha na autenticação');
        }

        firebaseReady = true;
        statusDot.className = 'w-2 h-2 rounded-full bg-emerald-400';
        statusText.textContent = 'Sincronizado ao vivo';
      } catch (err) {
        console.warn('Modo online indisponível, alternando para offline:', err);
        firebaseReady = false;
        statusDot.className = 'w-2 h-2 rounded-full bg-amber-300';
        statusText.textContent = 'Modo Local (Offline)';
        switchDeviceMode('offline');
      }
    }

    function getRoomDocRef(roomCode) {
      return doc(db, 'artifacts', appId, 'public', 'data', 'duelo_rooms', String(roomCode));
    }

    /* -------------------------------------------------------------------------
       4B. UTILITÁRIOS DE UI E NAVEGAÇÃO ENTRE MODOS
       ------------------------------------------------------------------------- */
    let toastTimeout = null;
    function showToast(msg) {
      const banner = document.getElementById('toast-banner');
      document.getElementById('toast-text').textContent = msg;
      banner.classList.remove('hidden');
      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        banner.classList.add('hidden');
      }, 2800);
    }

    function switchDeviceMode(mode) {
      if (mode === 'online' && !firebaseReady) {
        showToast('Conexão online indisponível neste navegador. Usando modo offline.');
        mode = 'offline';
      }
      deviceMode = mode;

      const tabOnline = document.getElementById('tab-device-online');
      const tabOffline = document.getElementById('tab-device-offline');
      const panelOnline = document.getElementById('setup-online-panel');
      const panelOffline = document.getElementById('setup-offline-panel');

      if (mode === 'online') {
        tabOnline.className = 'px-3.5 sm:px-5 py-2 rounded-xl bg-red-600 text-white font-extrabold text-xs sm:text-sm shadow transition cursor-pointer';
        tabOffline.className = 'px-3.5 sm:px-5 py-2 rounded-xl bg-white/80 hover:bg-white text-stone-700 font-bold text-xs sm:text-sm transition cursor-pointer';
        panelOnline.classList.remove('hidden');
        panelOffline.classList.add('hidden');
        document.getElementById('header-subtitle').textContent = 'Pastel ou Pizza • 2 Celulares ao Vivo';
      } else {
        tabOffline.className = 'px-3.5 sm:px-5 py-2 rounded-xl bg-red-600 text-white font-extrabold text-xs sm:text-sm shadow transition cursor-pointer';
        tabOnline.className = 'px-3.5 sm:px-5 py-2 rounded-xl bg-white/80 hover:bg-white text-stone-700 font-bold text-xs sm:text-sm transition cursor-pointer';
        panelOffline.classList.remove('hidden');
        panelOnline.classList.add('hidden');
        document.getElementById('header-subtitle').textContent = 'Pastel ou Pizza • Mesmo Celular';
        renderSetupHeroPreview();
        renderSetupIngredientsGrid();
      }
    }

    function setMyOnlineName(name) {
      document.getElementById('input-online-my-name').value = name;
      playTone(620, 'sine', 0.06, 0.08);
    }

    function selectGameMode(mode) {
      selectedMode = mode;

      // Atualiza cards do modo offline
      const cardPastel = document.getElementById('mode-card-pastel');
      const cardPizza = document.getElementById('mode-card-pizza');
      const checkPastel = document.getElementById('mode-check-pastel');
      const checkPizza = document.getElementById('mode-check-pizza');

      // Atualiza botões de criação rápida online
      const btnCreatePastel = document.getElementById('online-create-pastel');
      const btnCreatePizza = document.getElementById('online-create-pizza');

      if (mode === 'pastel') {
        if (cardPastel) {
          cardPastel.className = 'text-left p-4 sm:p-5 rounded-3xl border-4 border-amber-500 bg-amber-50 shadow-md transition-all flex items-center gap-4 cursor-pointer relative overflow-hidden';
          cardPizza.className = 'text-left p-4 sm:p-5 rounded-3xl border-3 border-stone-200 bg-white hover:border-red-300 hover:bg-red-50/40 transition-all flex items-center gap-4 cursor-pointer relative overflow-hidden';
          checkPastel.classList.remove('hidden');
          checkPizza.classList.add('hidden');
        }
        if (btnCreatePastel) {
          btnCreatePastel.className = 'p-3 rounded-2xl border-3 border-amber-500 bg-white shadow-xs text-center transition cursor-pointer';
          btnCreatePizza.className = 'p-3 rounded-2xl border-2 border-stone-200 bg-white/70 hover:bg-white text-center transition cursor-pointer';
        }
        document.getElementById('header-mode-icon').textContent = '🥟';
      } else {
        if (cardPizza) {
          cardPizza.className = 'text-left p-4 sm:p-5 rounded-3xl border-4 border-red-500 bg-red-50 shadow-md transition-all flex items-center gap-4 cursor-pointer relative overflow-hidden';
          cardPastel.className = 'text-left p-4 sm:p-5 rounded-3xl border-3 border-stone-200 bg-white hover:border-amber-300 hover:bg-amber-50/40 transition-all flex items-center gap-4 cursor-pointer relative overflow-hidden';
          checkPizza.classList.remove('hidden');
          checkPastel.classList.add('hidden');
        }
        if (btnCreatePizza) {
          btnCreatePizza.className = 'p-3 rounded-2xl border-3 border-red-500 bg-white shadow-xs text-center transition cursor-pointer';
          btnCreatePastel.className = 'p-3 rounded-2xl border-2 border-stone-200 bg-white/70 hover:bg-white text-center transition cursor-pointer';
        }
        document.getElementById('header-mode-icon').textContent = '🍕';
      }

      if (deviceMode === 'offline') {
        renderSetupHeroPreview();
      }
      playBidRaiseSound(4);
    }

    function renderSetupHeroPreview() {
      const sample = ['carne_moida', 'mussarela', 'calabresa', 'catupiry', 'ovo', 'azeitona', 'tomate_oregano'];
      const target = document.getElementById('setup-hero-art');
      if (target) target.innerHTML = renderDishSVG(selectedMode, sample);
    }

    /* -------------------------------------------------------------------------
       4C. SALA ONLINE EM 2 CELULARES (CRIAR, ENTRAR, LOBBY COLABORATIVO)
       ------------------------------------------------------------------------- */
    function showOnlineEntryError(msg) {
      const el = document.getElementById('online-entry-error');
      if (!msg) {
        el.classList.add('hidden');
        return;
      }
      el.textContent = msg;
      el.classList.remove('hidden');
    }

    async function createOnlineRoom() {
      if (!firebaseReady || !currentUser) {
        showOnlineEntryError('Aguarde a conexão ao vivo terminar de carregar...');
        return;
      }

      showOnlineEntryError(null);
      const myName = document.getElementById('input-online-my-name').value.trim() || 'Eu';
      const btn = document.getElementById('btn-create-room');
      btn.disabled = true;
      btn.textContent = '⏳ Criando sala...';

      try {
        // Gera código único de 4 dígitos
        let roomCode = '';
        for (let attempt = 0; attempt < 8; attempt++) {
          const candidate = String(Math.floor(1000 + Math.random() * 9000));
          const snap = await getDoc(getRoomDocRef(candidate));
          if (!snap.exists() || snap.data().status === 'finished') {
            roomCode = candidate;
            break;
          }
        }
        if (!roomCode) {
          roomCode = String(Math.floor(1000 + Math.random() * 9000));
        }

        const allIds = INGREDIENTS_DB.map(i => i.id);
        const initialOwners = {};
        allIds.forEach(id => { initialOwners[id] = 0; });

        const roomPayload = {
          roomCode,
          status: 'lobby', // 'lobby' | 'playing' | 'finished'
          mode: selectedMode,
          p1Uid: currentUser.uid,
          p1Name: myName,
          p1Money: INITIAL_BUDGET,
          p1WonItems: [],
          p2Uid: null,
          p2Name: '',
          p2Money: INITIAL_BUDGET,
          p2WonItems: [],
          selectedIngredients: allIds,
          ingredientOwners: initialOwners,
          deck: [],
          itemNumber: 1,
          currentIngredientId: null,
          currentBid: 0,
          highestBidderIndex: null,
          activeTurnIndex: 0,
          passesCount: 0,
          bidHistory: [],
          roundPhase: 'bidding',
          roundOutcome: null,
          updatedAt: Date.now()
        };

        await setDoc(getRoomDocRef(roomCode), roomPayload);

        currentRoomCode = roomCode;
        myPlayerIndex = 0;
        subscribeToOnlineRoom(roomCode);
        playFanfareSound();
        showToast(`Sala ${roomCode} criada! Compartilhe o código com seu par.`);
      } catch (err) {
        console.error('Erro ao criar sala:', err);
        showOnlineEntryError('Não foi possível criar a sala. Tente novamente.');
      } finally {
        btn.disabled = false;
        btn.textContent = '✨ Criar Sala (4 Dígitos)';
      }
    }

    async function joinOnlineRoom() {
      if (!firebaseReady || !currentUser) {
        showOnlineEntryError('Aguarde a conexão ao vivo terminar de carregar...');
        return;
      }

      showOnlineEntryError(null);
      const rawCode = document.getElementById('input-join-room-code').value.trim().replace(/\D/g, '');
      if (rawCode.length !== 4) {
        showOnlineEntryError('⚠️ Digite o código completo de 4 dígitos da sala.');
        return;
      }

      const myName = document.getElementById('input-online-my-name').value.trim() || 'Namorada';
      const btn = document.getElementById('btn-join-room');
      btn.disabled = true;
      btn.textContent = '⏳ Entrando...';

      try {
        const ref = getRoomDocRef(rawCode);
        const snap = await getDoc(ref);

        if (!snap.exists()) {
          showOnlineEntryError(`⚠️ Nenhuma sala encontrada com o código ${rawCode}. Confira os números!`);
          return;
        }

        const data = snap.data();

        if (data.p1Uid === currentUser.uid) {
          currentRoomCode = rawCode;
          myPlayerIndex = 0;
          subscribeToOnlineRoom(rawCode);
          return;
        }

        if (data.p2Uid === currentUser.uid) {
          currentRoomCode = rawCode;
          myPlayerIndex = 1;
          subscribeToOnlineRoom(rawCode);
          return;
        }

        if (data.p2Uid) {
          showOnlineEntryError('⚠️ Esta sala já está com 2 jogadores conectados!');
          return;
        }

        // Evita nomes idênticos caso ambos deixem "Eu"
        const finalP2Name = (myName.toLowerCase() === (data.p1Name || '').toLowerCase())
          ? `${myName} (2)`
          : myName;

        await updateDoc(ref, {
          p2Uid: currentUser.uid,
          p2Name: finalP2Name,
          updatedAt: Date.now()
        });

        currentRoomCode = rawCode;
        myPlayerIndex = 1;
        subscribeToOnlineRoom(rawCode);
        playFanfareSound();
        showToast(`Conectado na sala ${rawCode}!`);
      } catch (err) {
        console.error('Erro ao entrar na sala:', err);
        showOnlineEntryError('Erro ao conectar na sala. Verifique o código e tente novamente.');
      } finally {
        btn.disabled = false;
        btn.textContent = '📲 Entrar na Sala';
      }
    }

    function subscribeToOnlineRoom(roomCode) {
      if (roomUnsubscribe) {
        roomUnsubscribe();
        roomUnsubscribe = null;
      }

      const ref = getRoomDocRef(roomCode);
      roomUnsubscribe = onSnapshot(
        ref,
        (snap) => {
          if (!snap.exists()) {
            showToast('A sala foi encerrada.');
            leaveOnlineRoom();
            return;
          }
          const data = snap.data();
          const prevSnap = lastRoomSnapshot;
          lastRoomSnapshot = data;
          syncRoomStateToUI(data, prevSnap);
        },
        (error) => {
          console.error('Erro na sincronização em tempo real:', error);
          showToast('Oscilação na conexão ao vivo. Tentando reconectar...');
        }
      );
    }

    function leaveOnlineRoom() {
      if (roomUnsubscribe) {
        roomUnsubscribe();
        roomUnsubscribe = null;
      }
      if (autoAdvanceTimer) {
        clearTimeout(autoAdvanceTimer);
        autoAdvanceTimer = null;
      }
      currentRoomCode = null;
      lastRoomSnapshot = null;
      document.getElementById('header-room-badge').classList.add('hidden');
      document.getElementById('header-round-badge').classList.add('hidden');
      document.getElementById('online-lobby-view').classList.add('hidden');
      document.getElementById('online-entry-view').classList.remove('hidden');
      document.getElementById('screen-game').classList.add('hidden');
      document.getElementById('screen-final').classList.add('hidden');
      document.getElementById('screen-setup').classList.remove('hidden');
    }

    function copyRoomCode() {
      if (!currentRoomCode) return;
      const inviteText = `Vem disputar comigo no Duelo Gastronômico! Código da sala: ${currentRoomCode}`;
      const textarea = document.createElement('textarea');
      textarea.value = currentRoomCode;
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      try {
        document.execCommand('copy');
        showToast(`Código ${currentRoomCode} copiado! Cole no WhatsApp.`);
      } catch (e) {
        showToast(`Código da sala: ${currentRoomCode}`);
      }
      document.body.removeChild(textarea);
      playTone(720, 'sine', 0.08, 0.12);
    }

