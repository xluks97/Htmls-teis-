    /**
     * Sincroniza qualquer atualização vinda do Firestore (lobby, leilão ou final)
     * instantaneamente para a tela do aparelho.
     */
    function syncRoomStateToUI(data, prevData) {
      if (data.status === 'lobby') {
        if (autoAdvanceTimer) {
          clearTimeout(autoAdvanceTimer);
          autoAdvanceTimer = null;
        }
        renderLobbyView(data);
        if (prevData && !prevData.p2Uid && data.p2Uid && myPlayerIndex === 0) {
          playFanfareSound();
          showToast(`🎉 ${data.p2Name} entrou na sala!`);
        }
        return;
      }

      // Atualiza gameState local a partir do documento da sala
      const pool = (data.selectedIngredients || [])
        .map(id => INGREDIENTS_DB.find(i => i.id === id))
        .filter(Boolean);

      const currentIng = INGREDIENTS_DB.find(i => i.id === data.currentIngredientId) || pool[0] || INGREDIENTS_DB[0];

      gameState = {
        isOnline: true,
        mode: data.mode || 'pastel',
        players: [
          {
            name: data.p1Name || 'Jogador 1',
            money: typeof data.p1Money === 'number' ? data.p1Money : INITIAL_BUDGET,
            wonItems: data.p1WonItems || []
          },
          {
            name: data.p2Name || 'Jogador 2',
            money: typeof data.p2Money === 'number' ? data.p2Money : INITIAL_BUDGET,
            wonItems: data.p2WonItems || []
          }
        ],
        selectedPool: pool,
        deck: data.deck || [],
        itemNumber: data.itemNumber || 1,
        currentIngredient: currentIng,
        currentBid: data.currentBid || 0,
        highestBidderIndex: data.highestBidderIndex !== undefined ? data.highestBidderIndex : null,
        activeTurnIndex: data.activeTurnIndex || 0,
        passesCount: data.passesCount || 0,
        bidHistory: data.bidHistory || [],
        customSliderVal: (data.currentBid || 0) + 1,
        roundPhase: data.roundPhase || 'bidding',
        roundOutcome: data.roundOutcome || null
      };

      // Sons de feedback quando o oponente faz um lance
      if (prevData && prevData.status === 'playing' && data.status === 'playing') {
        if (data.currentBid > (prevData.currentBid || 0) && data.highestBidderIndex !== myPlayerIndex) {
          playBidRaiseSound(data.currentBid);
        }
        if (prevData.roundPhase === 'bidding' && data.roundPhase === 'hammer') {
          if (data.roundOutcome?.type === 'won') playGavelSound();
          else playTone(280, 'triangle', 0.18, 0.14);
        }
      }

      if (data.status === 'finished') {
        if (autoAdvanceTimer) {
          clearTimeout(autoAdvanceTimer);
          autoAdvanceTimer = null;
        }
        showFinalResults();
        return;
      }

      // status === 'playing'
      document.getElementById('screen-setup').classList.add('hidden');
      document.getElementById('screen-final').classList.add('hidden');
      document.getElementById('screen-game').classList.remove('hidden');
      document.getElementById('header-round-badge').classList.remove('hidden');
      document.getElementById('header-round-badge').textContent = `Disputa #${gameState.itemNumber}`;
      document.getElementById('header-mode-icon').textContent = gameState.mode === 'pizza' ? '🍕' : '🥟';

      renderCurrentIngredientHeader(false);
      renderAuctionStage();

      // Se a rodada acabou de bater o martelo, o anfitrião agenda o avanço automático em 2.5s
      if (gameState.roundPhase === 'hammer') {
        if (autoAdvanceTimer) clearTimeout(autoAdvanceTimer);
        if (myPlayerIndex === 0) {
          const expectedItemNum = gameState.itemNumber;
          autoAdvanceTimer = setTimeout(() => {
            if (lastRoomSnapshot && lastRoomSnapshot.status === 'playing' && lastRoomSnapshot.roundPhase === 'hammer' && lastRoomSnapshot.itemNumber === expectedItemNum) {
              advanceToNextItem();
            }
          }, 2500);
        }
      } else if (autoAdvanceTimer) {
        clearTimeout(autoAdvanceTimer);
        autoAdvanceTimer = null;
      }
    }

