    function toggleSetupIngredient(id) {
      if (selectedIngredientIds.has(id)) selectedIngredientIds.delete(id);
      else selectedIngredientIds.add(id);
      renderSetupIngredientsGrid();
      playTone(selectedIngredientIds.has(id) ? 620 : 420, 'sine', 0.06, 0.08);
    }

    function applyIngredientPreset(preset) {
      selectedIngredientIds.clear();
      if (preset === 'all') {
        INGREDIENTS_DB.forEach(i => selectedIngredientIds.add(i.id));
      } else if (preset === 'savory') {
        INGREDIENTS_DB.filter(i => i.category === 'Salgado').forEach(i => selectedIngredientIds.add(i.id));
      } else if (preset === 'classic') {
        INGREDIENTS_DB.filter(i => i.classic).forEach(i => selectedIngredientIds.add(i.id));
      }
      renderSetupIngredientsGrid();
      playBidRaiseSound(6);
    }

    function shuffleArray(arr) {
      const copy = [...arr];
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy;
    }

    function startOfflineGame() {
      if (selectedIngredientIds.size < 4) return;
      const p1Name = document.getElementById('input-p1-name').value.trim() || 'Eu';
      const p2Name = document.getElementById('input-p2-name').value.trim() || 'Namorada';
      const pool = INGREDIENTS_DB.filter(i => selectedIngredientIds.has(i.id));

      gameState = {
        isOnline: false,
        mode: selectedMode,
        players: [
          { name: p1Name, money: INITIAL_BUDGET, wonItems: [] },
          { name: p2Name, money: INITIAL_BUDGET, wonItems: [] }
        ],
        selectedPool: pool,
        deck: shuffleArray(pool),
        itemNumber: 1,
        currentIngredient: null,
        currentBid: 0,
        highestBidderIndex: null,
        activeTurnIndex: 0,
        passesCount: 0,
        bidHistory: [],
        customSliderVal: 1,
        roundPhase: 'bidding',
        roundOutcome: null
      };

      document.getElementById('screen-setup').classList.add('hidden');
      document.getElementById('screen-final').classList.add('hidden');
      document.getElementById('screen-game').classList.remove('hidden');
      document.getElementById('header-round-badge').classList.remove('hidden');

      playBidRaiseSound(5);
      startNextOfflineItem();
    }

    function startNextOfflineItem() {
      if (gameState.players[0].money <= 0 && gameState.players[1].money <= 0) {
        showFinalResults();
        return;
      }

      let replenished = false;
      if (gameState.deck.length === 0) {
        gameState.deck = shuffleArray(gameState.selectedPool);
        replenished = true;
      }

      gameState.currentIngredient = gameState.deck.pop();
      gameState.currentBid = 0;
      gameState.highestBidderIndex = null;
      gameState.passesCount = 0;
      gameState.bidHistory = [];
      gameState.roundPhase = 'bidding';
      gameState.roundOutcome = null;

      const preferredOpener = (gameState.itemNumber - 1) % 2;
      gameState.activeTurnIndex = gameState.players[preferredOpener].money > 0
        ? preferredOpener
        : 1 - preferredOpener;

      document.getElementById('header-round-badge').textContent = `Disputa #${gameState.itemNumber}`;
      renderCurrentIngredientHeader(replenished);
      renderAuctionStage();
    }

    /* -------------------------------------------------------------------------
       5. ARENA DO LEILÃO ABERTO (SINCRONIZADO ONLINE + OFFLINE)
       ------------------------------------------------------------------------- */
    function setDishViewMode(viewMode) {
      dishViewMode = viewMode;
      renderAuctionStage();
    }

    function renderCurrentIngredientHeader(replenished = false) {
      const ing = gameState.currentIngredient;
      if (!ing) return;
      document.getElementById('auction-item-icon').textContent = ing.emoji;
      document.getElementById('auction-item-name').textContent = ing.name;
      document.getElementById('auction-item-category').textContent = ing.category;
      document.getElementById('auction-item-points').textContent = `⭐ Sabor: +${ing.points} pts`;
      document.getElementById('auction-item-desc').textContent = ing.desc;
      document.getElementById('auction-item-hint').textContent = `💡 ${ing.hint}`;

      const rem = gameState.deck.length;
      document.getElementById('auction-deck-remaining').textContent = replenished
        ? `🔄 Porção extra! Restam ${rem}`
        : `Na fila: ${rem}`;
    }

    function renderAuctionStage() {
      const [p1, p2] = gameState.players;
      const activeIdx = gameState.activeTurnIndex;
      const activePlayer = gameState.players[activeIdx];
      const otherPlayer = gameState.players[1 - activeIdx];
      const isHammerClosed = gameState.roundPhase === 'hammer';

      // 1. Gerencia abas de visualização de prato no modo 2 Celulares
      const onlineTabs = document.getElementById('online-dish-tabs');
      const spotlightCard = document.getElementById('online-single-dish-spotlight');
      const bothGrid = document.getElementById('hud-both-grid');

      if (gameState.isOnline) {
        onlineTabs.classList.remove('hidden');
        const me = gameState.players[myPlayerIndex];
        const partner = gameState.players[1 - myPlayerIndex];

        document.getElementById('tab-view-mine').textContent = `🍽️ Meu Prato (${me.wonItems.length})`;
        document.getElementById('tab-view-partner').textContent = `👀 ${partner.name} (${partner.wonItems.length})`;

        const activeTabCls = 'flex-1 py-2 px-2.5 rounded-xl bg-amber-400 text-stone-950 font-extrabold text-xs sm:text-sm shadow-xs transition cursor-pointer';
        const idleTabCls = 'flex-1 py-2 px-2.5 rounded-xl bg-stone-100 hover:bg-stone-200 text-stone-700 font-bold text-xs sm:text-sm transition cursor-pointer';

        document.getElementById('tab-view-mine').className = dishViewMode === 'mine' ? activeTabCls : idleTabCls;
        document.getElementById('tab-view-partner').className = dishViewMode === 'partner' ? activeTabCls : idleTabCls;
        document.getElementById('tab-view-both').className = dishViewMode === 'both' ? activeTabCls : idleTabCls;

        if (dishViewMode === 'both') {
          spotlightCard.classList.add('hidden');
          bothGrid.classList.remove('hidden');
        } else {
          bothGrid.classList.add('hidden');
          spotlightCard.classList.remove('hidden');

          const targetIdx = dishViewMode === 'mine' ? myPlayerIndex : (1 - myPlayerIndex);
          const targetPlayer = gameState.players[targetIdx];
          const otherP = gameState.players[1 - targetIdx];

          spotlightCard.className = targetIdx === 0
            ? 'bg-white rounded-3xl p-4 border-3 border-teal-400 shadow-md'
            : 'bg-white rounded-3xl p-4 border-3 border-rose-400 shadow-md';

          document.getElementById('spotlight-avatar').textContent = targetIdx === 0 ? '😎' : '😍';
          document.getElementById('spotlight-role-label').textContent = dishViewMode === 'mine'
            ? 'Seu Prato Montado ao Vivo'
            : `Prato de ${targetPlayer.name} ao Vivo`;
          document.getElementById('spotlight-name').textContent = targetPlayer.name;
          document.getElementById('spotlight-money').textContent = `R$ ${targetPlayer.money}`;
          document.getElementById('spotlight-other-label').textContent = `Saldo ${otherP.name}`;
          document.getElementById('spotlight-other-money').textContent = `R$ ${otherP.money}`;
          document.getElementById('spotlight-dish-svg').innerHTML = renderDishSVG(gameState.mode, targetPlayer.wonItems);

          const spotChips = document.getElementById('spotlight-chips');
          if (targetPlayer.wonItems.length === 0) {
            spotChips.innerHTML = `<span class="text-xs text-stone-400 italic">Nenhum ingrediente arrematado ainda</span>`;
          } else {
            spotChips.innerHTML = targetPlayer.wonItems.map(item => {
              const info = INGREDIENTS_DB.find(i => i.id === item.id);
              return `<span class="inline-flex items-center gap-1 text-xs font-bold bg-amber-100 border border-amber-300 px-2 py-0.5 rounded-lg">${info.emoji} ${info.shortName} <span class="text-stone-500">R$${item.price}</span></span>`;
            }).join('');
          }
        }
      } else {
        onlineTabs.classList.add('hidden');
        spotlightCard.classList.add('hidden');
        bothGrid.classList.remove('hidden');
      }

      // 2. Atualiza HUD Lado a Lado
      [0, 1].forEach(idx => {
        const p = gameState.players[idx];
        const prefix = idx === 0 ? 'p1' : 'p2';
        const isTurn = !isHammerClosed && activeIdx === idx;
        const card = document.getElementById(`hud-card-${prefix}`);
        const tag = document.getElementById(`hud-${prefix}-turn-tag`);

        const meSuffix = (gameState.isOnline && idx === myPlayerIndex) ? ' (Você)' : '';
        document.getElementById(`hud-${prefix}-name`).textContent = `${p.name}${meSuffix}`;
        document.getElementById(`hud-${prefix}-money`).textContent = `R$ ${p.money}`;
        document.getElementById(`hud-${prefix}-dish`).innerHTML = renderDishSVG(gameState.mode, p.wonItems);

        if (idx === 0) {
          card.className = isTurn
            ? 'bg-white rounded-3xl p-3 sm:p-4 border-4 border-teal-500 ring-4 ring-teal-200/70 shadow-lg transition-all relative'
            : 'bg-white rounded-3xl p-3 sm:p-4 border-2 border-teal-200 shadow-sm transition-all relative opacity-95';
          tag.textContent = p.money === 0 ? 'Sem saldo' : (isTurn ? '⚡ Na vez!' : 'Aguardando');
          tag.className = isTurn
            ? 'inline-block text-[10px] sm:text-xs font-extrabold uppercase tracking-wide px-2.5 py-0.5 rounded-full mt-0.5 bg-teal-600 text-white'
            : 'inline-block text-[10px] sm:text-xs font-bold uppercase tracking-wide px-2 py-0.5 rounded-full mt-0.5 bg-stone-100 text-stone-500';
        } else {
          card.className = isTurn
            ? 'bg-white rounded-3xl p-3 sm:p-4 border-4 border-rose-500 ring-4 ring-rose-200/70 shadow-lg transition-all relative'
            : 'bg-white rounded-3xl p-3 sm:p-4 border-2 border-rose-200 shadow-sm transition-all relative opacity-95';
          tag.textContent = p.money === 0 ? 'Sem saldo' : (isTurn ? '⚡ Na vez!' : 'Aguardando');
          tag.className = isTurn
            ? 'inline-block text-[10px] sm:text-xs font-extrabold uppercase tracking-wide px-2.5 py-0.5 rounded-full mt-0.5 bg-rose-600 text-white'
            : 'inline-block text-[10px] sm:text-xs font-bold uppercase tracking-wide px-2 py-0.5 rounded-full mt-0.5 bg-stone-100 text-stone-500';
        }

        const chipsBox = document.getElementById(`hud-${prefix}-chips`);
        if (p.wonItems.length === 0) {
          chipsBox.innerHTML = `<span class="text-[11px] text-stone-400 italic">Nenhum ingrediente ainda</span>`;
        } else {
          chipsBox.innerHTML = p.wonItems.map(item => {
            const info = INGREDIENTS_DB.find(i => i.id === item.id);
            return `<span class="inline-flex items-center gap-0.5 text-[11px] font-bold bg-amber-100 border border-amber-300 px-1.5 py-0.5 rounded-md">${info.emoji} <span class="text-stone-600">R$${item.price}</span></span>`;
          }).join('');
        }
      });

      // 3. Banner de Status do Lance Atual
      const statusBanner = document.getElementById('bid-status-banner');
      const statusKicker = document.getElementById('bid-status-kicker');
      const statusHeadline = document.getElementById('bid-status-headline');
      const statusSubtext = document.getElementById('bid-status-subtext');

      if (gameState.currentBid === 0) {
        statusBanner.className = 'rounded-2xl p-4 border-2 border-amber-300 bg-amber-50/80 text-center mb-4 transition-all';
        statusKicker.textContent = otherPlayer.money === 0
          ? `⚠️ ${otherPlayer.name} já zerou o saldo!`
          : 'Abertura do Leilão';
        statusHeadline.textContent = 'Lance atual: R$ 0 (Ninguém apostou ainda)';
        statusSubtext.textContent = `Vez de ${activePlayer.name} abrir o leilão ou passar!`;
      } else {
        const leader = gameState.players[gameState.highestBidderIndex];
        const isLeaderP1 = gameState.highestBidderIndex === 0;
        statusBanner.className = isLeaderP1
          ? 'rounded-2xl p-4 border-3 border-teal-400 bg-p1-light text-center mb-4 transition-all'
          : 'rounded-2xl p-4 border-3 border-rose-400 bg-p2-light text-center mb-4 transition-all';
        statusKicker.textContent = '🔥 Disputa em Andamento!';
        statusHeadline.textContent = `Lance atual: R$ ${gameState.currentBid} — de ${leader.name}`;
        statusSubtext.textContent = `Vez de ${activePlayer.name}: cubra com R$ ${gameState.currentBid + 1}+ ou deixe ${leader.name} levar!`;
      }

      // 4. Histórico da disputa atual
      const histWrap = document.getElementById('bid-history-wrapper');
      const histTrail = document.getElementById('bid-history-trail');
      if (gameState.bidHistory.length === 0) {
        histWrap.classList.add('hidden');
      } else {
        histWrap.classList.remove('hidden');
        histTrail.innerHTML = gameState.bidHistory.map((h, i) => {
          const pillClass = h.playerIdx === 0
            ? 'bg-teal-100 text-teal-900 border-teal-300'
            : 'bg-rose-100 text-rose-900 border-rose-300';
          const arrow = i > 0 ? `<span class="text-stone-400 text-xs">→</span>` : '';
          return `${arrow}<span class="text-xs font-extrabold px-2.5 py-0.5 rounded-full border ${pillClass}">${h.text}</span>`;
        }).join('');
      }

      // 5. Se o Martelo já bateu nesta rodada, exibe o painel de resultado
      const controlsArea = document.getElementById('bidding-controls-area');
      const waitingArea = document.getElementById('opponent-waiting-area');
      const hammerArea = document.getElementById('hammer-result-area');

      if (isHammerClosed && gameState.roundOutcome) {
        controlsArea.classList.add('hidden');
        waitingArea.classList.add('hidden');
        hammerArea.classList.remove('hidden');

        const out = gameState.roundOutcome;
        const box = document.getElementById('hammer-outcome-box');
        const ing = INGREDIENTS_DB.find(i => i.id === out.ingId) || gameState.currentIngredient;

        if (out.type === 'skipped') {
          box.className = 'p-5 rounded-3xl bg-stone-100 border-3 border-stone-300 text-stone-800 max-w-xl mx-auto shadow-xs';
          document.getElementById('hammer-outcome-title').textContent = `💨 Ninguém quis ${ing.emoji} ${ing.shortName}!`;
          document.getElementById('hammer-outcome-desc').textContent = 'Os dois passaram! Partindo para o próximo ingrediente...';
        } else {
          const winner = gameState.players[out.winnerIdx];
          box.className = out.winnerIdx === 0
            ? 'p-5 rounded-3xl bg-p1-light border-3 border-teal-500 text-teal-950 max-w-xl mx-auto shadow-sm'
            : 'p-5 rounded-3xl bg-p2-light border-3 border-rose-500 text-rose-950 max-w-xl mx-auto shadow-sm';
          const dishLabel = gameState.mode === 'pastel' ? 'pastel' : 'pizza';
          document.getElementById('hammer-outcome-title').textContent =
            `🎉 VENDIDO! ${winner.name} levou ${ing.emoji} ${ing.shortName} por R$ ${out.price}!`;
          document.getElementById('hammer-outcome-desc').textContent =
            `${out.reasonText} Colocado em cima ${gameState.mode === 'pastel' ? 'do' : 'da'} ${dishLabel} de ${winner.name}!`;
        }

        updateNextItemButton();
        return;
      }

      hammerArea.classList.add('hidden');

      // 6. Verifica se no modo 2 Celulares é a vez deste aparelho ou do parceiro
      const isMyTurn = !gameState.isOnline || (activeIdx === myPlayerIndex);

      if (!isMyTurn) {
        controlsArea.classList.add('hidden');
        waitingArea.classList.remove('hidden');
        document.getElementById('waiting-opponent-headline').textContent =
          `Aguardando ${activePlayer.name} dar o lance ou cobrir...`;
        document.getElementById('waiting-opponent-sub').textContent =
          gameState.currentBid === 0
            ? `${activePlayer.name} está decidindo se abre o leilão ou passa.`
            : `Seu lance atual é R$ ${gameState.currentBid}. Aguarde ${activePlayer.name} responder no celular dele(a)!`;
        return;
      }

      waitingArea.classList.add('hidden');
      controlsArea.classList.remove('hidden');

      // 7. Configura Controles Ativos do Jogador da Vez
      const turnCard = document.getElementById('active-turn-card');
      const turnName = document.getElementById('turn-player-name');
      const turnAvatar = document.getElementById('turn-player-avatar');
      const turnBalance = document.getElementById('turn-player-balance');
      const turnKicker = document.getElementById('turn-player-kicker');

      turnName.textContent = activePlayer.name;
      turnAvatar.textContent = activeIdx === 0 ? '😎' : '😍';
      turnBalance.textContent = `R$ ${activePlayer.money}`;
      turnKicker.textContent = gameState.currentBid === 0
        ? 'Sua vez! Dê o lance inicial ou passe'
        : 'Sua vez! Cubra o lance ou passe';

      if (activeIdx === 0) {
        turnCard.className = 'rounded-3xl p-4 sm:p-5 border-3 border-teal-400 bg-p1-light/70 transition-all';
        turnName.className = 'font-display text-2xl sm:text-3xl font-bold text-teal-900 leading-tight';
      } else {
        turnCard.className = 'rounded-3xl p-4 sm:p-5 border-3 border-rose-400 bg-p2-light/70 transition-all';
        turnName.className = 'font-display text-2xl sm:text-3xl font-bold text-rose-900 leading-tight';
      }

      const minAllowed = gameState.currentBid + 1;
      const maxAllowed = activePlayer.money;
      const quickBox = document.getElementById('quick-bid-buttons');

      const btnBaseColor = activeIdx === 0
        ? 'bg-teal-600 hover:bg-teal-700 text-white shadow-[0_3px_0_#115E59]'
        : 'bg-rose-600 hover:bg-rose-700 text-white shadow-[0_3px_0_#9F1239]';

      if (gameState.currentBid === 0) {
        const opts = [
          { label: 'Dar R$ 1', val: 1 },
          { label: 'Dar R$ 2', val: 2 },
          { label: 'Dar R$ 5', val: 5 },
          { label: `🔥 Tudo (R$ ${maxAllowed})`, val: maxAllowed }
        ];
        quickBox.innerHTML = opts.map(o => `
          <button
            type="button"
            onclick="placeBid(${o.val})"
            ${o.val > maxAllowed ? 'disabled' : ''}
            class="btn-3d py-3 px-3 rounded-2xl ${btnBaseColor} font-extrabold text-xs sm:text-sm cursor-pointer"
          >
            ${o.label}
          </button>
        `).join('');
      } else {
        const c1 = gameState.currentBid + 1;
        const c2 = gameState.currentBid + 2;
        const c5 = gameState.currentBid + 5;
        const opts = [
          { label: `Cobrir (+R$ 1 → R$ ${c1})`, val: c1 },
          { label: `+R$ 2 (→ R$ ${c2})`, val: c2 },
          { label: `+R$ 5 (→ R$ ${c5})`, val: c5 },
          { label: `🔥 All-in (R$ ${maxAllowed})`, val: maxAllowed }
        ];
        quickBox.innerHTML = opts.map(o => `
          <button
            type="button"
            onclick="placeBid(${o.val})"
            ${o.val > maxAllowed || o.val < minAllowed ? 'disabled' : ''}
            class="btn-3d py-3 px-3 rounded-2xl ${btnBaseColor} font-extrabold text-xs sm:text-sm cursor-pointer"
          >
            ${o.label}
          </button>
        `).join('');
      }

      const slider = document.getElementById('custom-bid-slider');
      slider.min = minAllowed;
      slider.max = maxAllowed;
      gameState.customSliderVal = minAllowed;
      slider.value = minAllowed;
      updateCustomBidSlider(minAllowed);

      const btnFold = document.getElementById('btn-fold-or-pass');
      if (gameState.currentBid === 0) {
        btnFold.textContent = '⏭️ Passar (Não quero)';
        btnFold.className = 'btn-3d w-full sm:w-auto px-7 py-3.5 rounded-2xl bg-stone-700 hover:bg-stone-800 text-white font-display text-lg sm:text-xl font-bold shadow-[0_4px_0_#292524] cursor-pointer';
      } else {
        const leaderName = gameState.players[gameState.highestBidderIndex].name;
        btnFold.textContent = `🏳️ Desistir (Deixar ${leaderName} levar)`;
        btnFold.className = 'btn-3d w-full sm:w-auto px-7 py-3.5 rounded-2xl bg-stone-800 hover:bg-stone-950 text-white font-display text-lg sm:text-xl font-bold shadow-[0_4px_0_#1C1917] cursor-pointer';
      }

      const btnFinishEarly = document.getElementById('btn-finish-early');
      if (otherPlayer.money === 0) btnFinishEarly.classList.remove('hidden');
      else btnFinishEarly.classList.add('hidden');
    }

    function updateCustomBidSlider(val) {
      const activePlayer = gameState.players[gameState.activeTurnIndex];
      const minAllowed = gameState.currentBid + 1;
      const clamped = Math.max(minAllowed, Math.min(activePlayer.money, val));
      gameState.customSliderVal = clamped;
      document.getElementById('custom-bid-slider').value = clamped;
      document.getElementById('custom-bid-preview').textContent = `R$ ${clamped}`;
      document.getElementById('btn-submit-custom-bid').textContent =
        gameState.currentBid === 0 ? `Abrir R$ ${clamped}` : `Cobrir R$ ${clamped}`;
    }

    function stepCustomBid(delta) {
      updateCustomBidSlider(gameState.customSliderVal + delta);
      playTone(540, 'sine', 0.04, 0.08);
    }

    function submitCustomBid() {
      placeBid(gameState.customSliderVal);
    }

    async function placeBid(amount) {
      if (gameState.isOnline && gameState.activeTurnIndex !== myPlayerIndex) return;
      if (gameState.roundPhase !== 'bidding') return;

      const bidderIdx = gameState.activeTurnIndex;
      const bidder = gameState.players[bidderIdx];
      const opponentIdx = 1 - bidderIdx;
      const opponent = gameState.players[opponentIdx];

      if (amount <= gameState.currentBid || amount > bidder.money) return;

      const isOpening = gameState.currentBid === 0;
      const newHistory = [
        ...gameState.bidHistory,
        {
          playerIdx: bidderIdx,
          text: isOpening ? `${bidder.name} abriu R$ ${amount}` : `${bidder.name} cobriu R$ ${amount}`
        }
      ];

      playBidRaiseSound(amount);

      // Se o oponente não tem saldo suficiente para cobrir (money < amount + 1), bate o martelo!
      if (opponent.money < amount + 1) {
        const autoReason = opponent.money === 0
          ? `${opponent.name} já zerou o saldo!`
          : `${opponent.name} tem apenas R$ ${opponent.money} e não consegue cobrir R$ ${amount}!`;

        const newWinnerMoney = Math.max(0, bidder.money - amount);
        const newWinnerItems = [...bidder.wonItems, { id: gameState.currentIngredient.id, price: amount }];
        const outcome = {
          type: 'won',
          winnerIdx: bidderIdx,
          price: amount,
          ingId: gameState.currentIngredient.id,
          reasonText: autoReason
        };

        if (gameState.isOnline) {
          const moneyKey = bidderIdx === 0 ? 'p1Money' : 'p2Money';
          const itemsKey = bidderIdx === 0 ? 'p1WonItems' : 'p2WonItems';
          await updateDoc(getRoomDocRef(currentRoomCode), {
            currentBid: amount,
            highestBidderIndex: bidderIdx,
            bidHistory: newHistory,
            [moneyKey]: newWinnerMoney,
            [itemsKey]: newWinnerItems,
            roundPhase: 'hammer',
            roundOutcome: outcome,
            updatedAt: Date.now()
          });
        } else {
          gameState.currentBid = amount;
          gameState.highestBidderIndex = bidderIdx;
          gameState.bidHistory = newHistory;
          bidder.money = newWinnerMoney;
          bidder.wonItems = newWinnerItems;
          gameState.roundPhase = 'hammer';
          gameState.roundOutcome = outcome;
          playGavelSound();
          renderAuctionStage();
        }
        return;
      }

      // Passa a vez para o oponente cobrir
      if (gameState.isOnline) {
        await updateDoc(getRoomDocRef(currentRoomCode), {
          currentBid: amount,
          highestBidderIndex: bidderIdx,
          activeTurnIndex: opponentIdx,
          bidHistory: newHistory,
          updatedAt: Date.now()
        });
      } else {
        gameState.currentBid = amount;
        gameState.highestBidderIndex = bidderIdx;
        gameState.activeTurnIndex = opponentIdx;
        gameState.bidHistory = newHistory;
        renderAuctionStage();
      }
    }

    async function handlePassOrFold() {
      if (gameState.isOnline && gameState.activeTurnIndex !== myPlayerIndex) return;
      if (gameState.roundPhase !== 'bidding') return;

      const actorIdx = gameState.activeTurnIndex;
      const actor = gameState.players[actorIdx];
      const opponentIdx = 1 - actorIdx;
      const opponent = gameState.players[opponentIdx];

      // Caso A: Ninguém apostou ainda (R$ 0) -> Passar
      if (gameState.currentBid === 0) {
        const newPasses = gameState.passesCount + 1;
        const newHistory = [
          ...gameState.bidHistory,
          { playerIdx: actorIdx, text: `${actor.name} passou` }
        ];
        playTone(340, 'sine', 0.1, 0.1);

        // Primeiro a passar, e o outro ainda tem saldo: passa a vez para o outro
        if (newPasses === 1 && opponent.money > 0) {
          if (gameState.isOnline) {
            await updateDoc(getRoomDocRef(currentRoomCode), {
              passesCount: newPasses,
              activeTurnIndex: opponentIdx,
              bidHistory: newHistory,
              updatedAt: Date.now()
            });
          } else {
            gameState.passesCount = newPasses;
            gameState.activeTurnIndex = opponentIdx;
            gameState.bidHistory = newHistory;
            renderAuctionStage();
          }
          return;
        }

        // Ambos passaram (R$ 0): pula o ingrediente!
        const outcome = {
          type: 'skipped',
          ingId: gameState.currentIngredient.id
        };

        if (gameState.isOnline) {
          await updateDoc(getRoomDocRef(currentRoomCode), {
            passesCount: newPasses,
            bidHistory: newHistory,
            roundPhase: 'hammer',
            roundOutcome: outcome,
            updatedAt: Date.now()
          });
        } else {
          gameState.passesCount = newPasses;
          gameState.bidHistory = newHistory;
          gameState.roundPhase = 'hammer';
          gameState.roundOutcome = outcome;
          playTone(280, 'triangle', 0.18, 0.14);
          renderAuctionStage();
        }
        return;
      }

      // Caso B: Já existe um lance maior -> Desistir e deixar o líder levar!
      const winnerIdx = gameState.highestBidderIndex;
      const winner = gameState.players[winnerIdx];
      const winPrice = gameState.currentBid;
      const newHistory = [
        ...gameState.bidHistory,
        { playerIdx: actorIdx, text: `${actor.name} desistiu` }
      ];

      const newWinnerMoney = Math.max(0, winner.money - winPrice);
      const newWinnerItems = [...winner.wonItems, { id: gameState.currentIngredient.id, price: winPrice }];
      const outcome = {
        type: 'won',
        winnerIdx,
        price: winPrice,
        ingId: gameState.currentIngredient.id,
        reasonText: `${actor.name} desistiu e deixou ${winner.name} levar!`
      };

      if (gameState.isOnline) {
        const moneyKey = winnerIdx === 0 ? 'p1Money' : 'p2Money';
        const itemsKey = winnerIdx === 0 ? 'p1WonItems' : 'p2WonItems';
        await updateDoc(getRoomDocRef(currentRoomCode), {
          bidHistory: newHistory,
          [moneyKey]: newWinnerMoney,
          [itemsKey]: newWinnerItems,
          roundPhase: 'hammer',
          roundOutcome: outcome,
          updatedAt: Date.now()
        });
      } else {
        gameState.bidHistory = newHistory;
        winner.money = newWinnerMoney;
        winner.wonItems = newWinnerItems;
        gameState.roundPhase = 'hammer';
        gameState.roundOutcome = outcome;
        playGavelSound();
        renderAuctionStage();
      }
    }

    function updateNextItemButton() {
      const bothZero = gameState.players[0].money <= 0 && gameState.players[1].money <= 0;
      const deckEmptyAndOnline = gameState.isOnline && gameState.deck.length === 0;
      const isEnding = bothZero || deckEmptyAndOnline;

      const btn = document.getElementById('btn-next-item');
      const autoHint = document.getElementById('auto-advance-hint');

      if (gameState.isOnline) {
        autoHint.classList.remove('hidden');
      } else {
        autoHint.classList.add('hidden');
      }

      if (isEnding) {
        const dishName = gameState.mode === 'pastel' ? 'Pastel Campeão' : 'Pizza Campeã';
        btn.textContent = `🏆 Ver ${dishName}`;
        btn.className = 'btn-3d px-9 py-4 rounded-2xl bg-gradient-to-b from-amber-400 to-amber-500 hover:from-amber-500 hover:to-amber-600 text-stone-950 font-display text-xl sm:text-2xl font-bold shadow-[0_4px_0_#B45309] border-2 border-amber-200 cursor-pointer';
      } else {
        btn.textContent = 'Próximo Ingrediente ➡️';
        btn.className = 'btn-3d px-9 py-4 rounded-2xl bg-gradient-to-b from-red-500 to-red-600 hover:from-red-600 hover:to-red-700 text-white font-display text-xl sm:text-2xl font-bold shadow-[0_4px_0_#991B1B] border-2 border-red-300 cursor-pointer';
      }
    }

    async function advanceToNextItem() {
      if (autoAdvanceTimer) {
        clearTimeout(autoAdvanceTimer);
        autoAdvanceTimer = null;
      }

      if (!gameState.isOnline) {
        if (gameState.players[0].money <= 0 && gameState.players[1].money <= 0) {
          showFinalResults();
        } else {
          gameState.itemNumber += 1;
          startNextOfflineItem();
        }
        return;
      }

      // Modo Online (2 Celulares)
      if (!currentUser || !currentRoomCode || !lastRoomSnapshot) return;
      if (lastRoomSnapshot.roundPhase !== 'hammer') return;

      const bothZero = gameState.players[0].money <= 0 && gameState.players[1].money <= 0;
      const deckCopy = [...gameState.deck];

      // Se ambos zeraram OU acabaram os ingredientes selecionados da sala, encerra e mostra o veredito final!
      if (bothZero || deckCopy.length === 0) {
        await updateDoc(getRoomDocRef(currentRoomCode), {
          status: 'finished',
          updatedAt: Date.now()
        });
        return;
      }

      const nextIngId = deckCopy.pop();
      const nextItemNum = gameState.itemNumber + 1;
      const preferredOpener = (nextItemNum - 1) % 2;
      const nextTurnIdx = gameState.players[preferredOpener].money > 0
        ? preferredOpener
        : 1 - preferredOpener;

      await updateDoc(getRoomDocRef(currentRoomCode), {
        deck: deckCopy,
        itemNumber: nextItemNum,
        currentIngredientId: nextIngId,
        currentBid: 0,
        highestBidderIndex: null,
        activeTurnIndex: nextTurnIdx,
        passesCount: 0,
        bidHistory: [],
        roundPhase: 'bidding',
        roundOutcome: null,
        updatedAt: Date.now()
      });
    }

    async function finishMatchNow() {
      if (gameState.isOnline) {
        if (!currentUser || !currentRoomCode) return;
        await updateDoc(getRoomDocRef(currentRoomCode), {
          status: 'finished',
          updatedAt: Date.now()
        });
      } else {
        showFinalResults();
      }
    }

    /* -------------------------------------------------------------------------
       6. AVALIAÇÃO FINAL (MESTRE PASTELEIRO OU MESTRE PIZZAIOLO)
       ------------------------------------------------------------------------- */
    function evaluateDish(wonItems, mode) {
      const uniqueIds = new Set(wonItems.map(i => i.id));
      const has = (id) => uniqueIds.has(id);

      const seenCount = {};
      let baseScore = 0;
      wonItems.forEach(entry => {
        const info = INGREDIENTS_DB.find(i => i.id === entry.id);
        seenCount[entry.id] = (seenCount[entry.id] || 0) + 1;
        if (seenCount[entry.id] === 1) baseScore += info.points;
        else baseScore += Math.round(info.points * 0.65);
      });

      const notes = [];
      let bonusScore = 0;

      if (has('carne_moida') && has('ovo') && has('azeitona')) {
        bonusScore += 18;
        notes.push({ type: 'bonus', title: '🏆 Clássico de Feira (+18 pts)', desc: 'Carne Moída + Ovo Cozido + Azeitonas: combinação lendária!' });
      }
      if (has('calabresa') && has('ovo') && has('azeitona') && has('tomate_oregano')) {
        bonusScore += 20;
        notes.push({ type: 'bonus', title: '🇵🇹 Portuguesa Raiz (+20 pts)', desc: 'Calabresa, Ovo, Azeitonas e Tomate & Orégano em perfeita harmonia!' });
      }
      if (has('frango') && has('catupiry')) {
        bonusScore += 16;
        notes.push({ type: 'bonus', title: '🍗 Frango com Catupiry Supremo (+16 pts)', desc: 'Cremosidade e sabor que conquistam qualquer jurado!' });
      }
      const cheeseCount = ['mussarela', 'catupiry', 'cheddar'].filter(has).length;
      if (cheeseCount >= 3) {
        bonusScore += 20;
        notes.push({ type: 'bonus', title: '🧀 Explosão Triplo Queijo (+20 pts)', desc: 'Mussarela + Catupiry + Cheddar puxando fio a cada pedaço!' });
      } else if (cheeseCount === 2) {
        bonusScore += 10;
        notes.push({ type: 'bonus', title: '🧀 Dupla de Queijos (+10 pts)', desc: 'Recheio super cremoso e bem equilibrado!' });
      }
      if (has('bacon') && has('calabresa')) {
        bonusScore += 15;
        notes.push({ type: 'bonus', title: '🥓 Dupla Defumada (+15 pts)', desc: 'Bacon Crocante + Calabresa com Cebola: aroma irresistível!' });
      }
      if (has('mussarela') && has('tomate_oregano')) {
        bonusScore += 14;
        notes.push({
          type: 'bonus',
          title: mode === 'pizza' ? '🇮🇹 Margherita Artesanal (+14 pts)' : '🍕 Sabor Pizza Italiana (+14 pts)',
          desc: 'Mussarela derretida com Tomate Fresco & Orégano!'
        });
      }
      if (has('goiabada') && (has('mussarela') || has('catupiry'))) {
        bonusScore += 20;
        notes.push({ type: 'bonus', title: '💘 Romeu & Julieta (+20 pts)', desc: 'O romance perfeito entre Goiabada Cremosa e Queijo!' });
      }
      if (has('chocolate') && has('banana')) {
        bonusScore += 18;
        notes.push({ type: 'bonus', title: '🍫 Doce Tentação (+18 pts)', desc: 'Chocolate ao Leite Derretido com Banana & Canela!' });
      }
      if (has('pimenta') && (has('carne_moida') || has('calabresa') || has('frango'))) {
        bonusScore += 12;
        notes.push({ type: 'bonus', title: '🌶️ Toque Picante na Medida (+12 pts)', desc: 'Pimenta Malagueta dando personalidade ao recheio salgado!' });
      }

      const heavySavory = ['carne_moida', 'frango', 'bacon', 'calabresa', 'azeitona', 'tomate_oregano', 'ovo', 'palmito', 'milho_ervilha'].filter(has);
      const heavySweet = ['chocolate', 'banana'].filter(has);

      if (heavySavory.length > 0 && heavySweet.length > 0) {
        const penalty = -14;
        bonusScore += penalty;
        const sName = INGREDIENTS_DB.find(i => i.id === heavySavory[0]).shortName;
        const dName = INGREDIENTS_DB.find(i => i.id === heavySweet[0]).shortName;
        const label = mode === 'pizza' ? '🚨 Crime Gastronômico Italiano' : '🤢 Gororoba Corajosa de Feira';
        notes.push({ type: 'gororoba', title: `${label} (${penalty} pts)`, desc: `Misturou ${sName} com ${dName}?! O jurado quase desmaiou!` });
      }
      if (has('pimenta') && (has('chocolate') || has('banana') || has('goiabada'))) {
        bonusScore -= 6;
        notes.push({ type: 'gororoba', title: '🔥 Sobremesa Explosiva (-6 pts)', desc: 'Pimenta Malagueta no meio do doce? Coragem não faltou!' });
      }
      if (wonItems.length === 0) {
        notes.push({
          type: 'gororoba',
          title: mode === 'pizza' ? '💨 Pizza só de Massa e Molho (0 pts)' : '💨 Pastel de Vento (0 pts)',
          desc: 'Não arrematou nenhum recheio durante o leilão!'
        });
      } else if (notes.length === 0) {
        notes.push({ type: 'neutral', title: '👍 Receita Bem Equilibrada', desc: 'Ingredientes saborosos sem misturas estranhas!' });
      }

      return { totalScore: Math.max(0, baseScore + bonusScore), notes };
    }

    function showFinalResults() {
