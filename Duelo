          currentIngredientId: firstIngId,
          currentBid: 0,
          highestBidderIndex: null,
          activeTurnIndex: 0,
          passesCount: 0,
          bidHistory: [],
          roundPhase: 'bidding',
          roundOutcome: null,
          updatedAt: Date.now()
        });
